    .cnav-btn { display: inline-flex; align-items: center; gap: 6px; padding: 12px 16px; font-size: 12.5px; font-weight: 500; color: #64748b; border-bottom: 2.5px solid transparent; border-top: none; border-left: none; border-right: none; white-space: nowrap; cursor: pointer; background: none; font-family: inherit; transition: color .18s, border-color .18s; min-height: 44px; -webkit-tap-highlight-color: transparent; }
