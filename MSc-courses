    /* ════════════════════════════
       LAYOUT — notebook paper feel
    ════════════════════════════ */
    :root {
      --ink: #1a1208; --paper: #fdfaf4; --parchment: #f4ede0;
      --accent: #8b2e0a; --accent2: #1a4a6b; --gold: #b8820a;
      --green-h: #1a5c2e; --teal-h: #0e5c6e; --purple-h: #5a2080;
      --faded: #8a7e6e; --rule: #ddd0b8; --hi: #fef3c7;
      --shadow: rgba(26,18,8,.1);
    }

    .notebook-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px 80px; }

    .course-block { padding: 52px 0 0; scroll-margin-top: 110px; }

    .course-banner {
      border-radius: 14px; padding: 32px 36px; margin-bottom: 40px;
      position: relative; overflow: hidden; color: #fff;
    }
    .course-banner::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 40px 40px; pointer-events: none; }
    .cb-gen    { background: linear-gradient(135deg, #07241c, #0e5c4a); }
    .cb-code { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 3px; text-transform: uppercase; color: rgba(255,255,255,.5); margin-bottom: 6px; }
    .cb-title { font-family: 'Playfair Display', serif; font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 700; margin-bottom: 6px; position: relative; z-index: 1; }
    .cb-sub { font-family: 'DM Mono', monospace; font-size: 11px; color: rgba(255,255,255,.6); letter-spacing: .5px; position: relative; z-index: 1; }
    .cb-watermark { position: absolute; right: -10px; top: -10px; font-size: 100px; opacity: .08; font-family: 'Playfair Display', serif; font-weight: 900; line-height: 1; user-select: none; }

    .toc-box { background: var(--parchment); border-left: 4px solid var(--gold); border-radius: 0 8px 8px 0; padding: 24px 28px; margin-bottom: 40px; }
    .toc-box-title { font-family: 'DM Mono', monospace; font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--gold); margin-bottom: 14px; }
    .toc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5px 28px; }
    .toc-link { font-family: 'DM Mono', monospace; font-size: 11.5px; color: var(--accent2); display: flex; align-items: center; gap: 8px; padding: 3px 0; transition: color .2s; }
    .toc-link:hover { color: var(--accent); }
    .toc-link::before { content: attr(data-n); color: var(--faded); font-size: 9.5px; min-width: 22px; }
    @media (max-width: 600px) { .toc-grid { grid-template-columns: 1fr; } }

    .topic-section { margin-bottom: 52px; scroll-margin-top: 110px; }
    .topic-header { display: flex; align-items: flex-start; gap: 18px; margin-bottom: 24px; }
    .topic-num { font-family: 'Playfair Display', serif; font-size: 52px; font-weight: 900; color: #e2e8f0; line-height: 1; min-width: 60px; user-select: none; }
    .topic-title-block { flex: 1; padding-top: 4px; }
    .topic-label { font-family: 'DM Mono', monospace; font-size: 9.5px; letter-spacing: 3px; text-transform: uppercase; color: var(--faded); margin-bottom: 4px; }
    .topic-title { font-family: 'Playfair Display', serif; font-size: clamp(16px, 2.5vw, 22px); font-weight: 700; color: var(--ink); line-height: 1.2; }
    .topic-title span { color: var(--accent); }

    .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; margin-bottom: 18px; }
    @media (max-width: 480px) { .cards { grid-template-columns: 1fr; } }

    .card { background: #fff; border: 1px solid #e8e0d0; border-radius: 10px; padding: 18px 20px; position: relative; overflow: hidden; transition: transform .2s, box-shadow .2s; }
    .card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px var(--shadow); }
    .card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; border-radius: 10px 10px 0 0; }
    .card.c-what::before  { background: var(--accent2); }
    .card.c-how::before   { background: var(--accent); }
    .card.c-where::before { background: var(--gold); }
    .card.c-warn::before  { background: #94a3b8; }
    .card.c-idea::before  { background: #1a5c2e; }
    .card.c-form::before  { background: #5a2080; }

    .card-icon { font-size: 20px; margin-bottom: 8px; display: block; }
    .card-lbl { font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 3px; text-transform: uppercase; margin-bottom: 7px; }
    .card.c-what  .card-lbl { color: var(--accent2); }
    .card.c-how   .card-lbl { color: var(--accent); }
    .card.c-where .card-lbl { color: var(--gold); }
    .card.c-warn  .card-lbl { color: #64748b; }
    .card.c-idea  .card-lbl { color: #1a5c2e; }
    .card.c-form  .card-lbl { color: #5a2080; }
    .card h3 { font-family: 'Playfair Display', serif; font-size: 14px; font-weight: 700; margin-bottom: 8px; color: var(--ink); }
    .card p, .card li { font-size: 13px; line-height: 1.72; color: #3d3020; }
    .card ul { list-style: none; padding: 0; }
    .card ul li::before { content: '—'; margin-right: 6px; color: var(--faded); }

    .note { background: var(--hi); border-left: 3px solid var(--gold); border-radius: 0 6px 6px 0; padding: 13px 16px; margin: 14px 0; font-size: 13px; line-height: 1.75; color: #4a3b1a; font-style: italic; }
    .note strong { font-style: normal; font-family: 'DM Mono', monospace; font-size: 9.5px; letter-spacing: 2px; text-transform: uppercase; color: var(--gold); display: block; margin-bottom: 4px; }

    .eq-block {
      background: #0f172a; color: #e2e8f0; border-radius: 10px;
      padding: 20px 24px; margin: 16px 0; position: relative; overflow: hidden;
    }
    .eq-block::before { content: 'Equations'; position: absolute; top: 10px; right: 14px; font-family: 'DM Mono', monospace; font-size: 9px; letter-spacing: 2px; color: #475569; text-transform: uppercase; }
    .eq-row { display: flex; align-items: baseline; gap: 14px; padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
    .eq-row:last-child { border-bottom: none; }
    .eq-name { font-family: 'DM Mono', monospace; font-size: 11.5px; color: #fbbf24; min-width: 200px; flex-shrink: 0; }
    .eq-val { font-family: 'DM Mono', monospace; font-size: 13px; color: #93c5fd; }
    .eq-val sub, .eq-val sup { font-size: .75em; }

    .viz-wrap { background: #fff; border: 1px solid #e8e0d0; border-radius: 12px; padding: 20px; margin: 18px 0; overflow-x: auto; }
    .viz-title { font-family: 'DM Mono', monospace; font-size: 10px; letter-spacing: 2.5px; text-transform: uppercase; color: var(--faded); margin-bottom: 14px; }
    .viz-wrap svg { display: block; max-width: 100%; height: auto; }

    .chips { display: flex; flex-wrap: wrap; gap: 7px; margin: 14px 0; }
    .chip { background: var(--parchment); border: 1px solid var(--rule); border-radius: 5px; padding: 4px 12px; font-family: 'DM Mono', monospace; font-size: 11px; color: var(--ink); transition: background .2s; cursor: default; }
    .chip:hover { background: var(--hi); }

    .divider { display: flex; align-items: center; gap: 12px; margin: 40px 0; color: var(--faded); font-family: 'DM Mono', monospace; font-size: 9.5px; letter-spacing: 3px; text-transform: uppercase; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: var(--rule); }

    .refs-box { background: var(--parchment); border: 1px solid var(--rule); border-radius: 10px; padding: 28px 32px; margin-top: 60px; }
    .refs-box h4 { font-family: 'Playfair Display', serif; font-size: 16px; margin-bottom: 20px; color: var(--ink); }
    .ref-entry { border-bottom: 1px solid var(--rule); padding: 12px 0; display: flex; gap: 16px; align-items: flex-start; }
    .ref-entry:last-child { border-bottom: none; }
    .ref-n { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--faded); min-width: 28px; padding-top: 2px; }
    .ref-title { font-family: 'Playfair Display', serif; font-size: 13.5px; font-weight: 700; font-style: italic; color: var(--accent); margin-bottom: 2px; }
    .ref-auth { font-family: 'DM Mono', monospace; font-size: 11px; color: var(--faded); }

    .nb-footer { text-align: center; margin-top: 60px; padding-top: 24px; border-top: 1px solid var(--rule); font-family: 'DM Mono', monospace; font-size: 9.5px; color: var(--faded); letter-spacing: 2px; text-transform: uppercase; }

    .more-soon-box { background: #fff; border: 1.5px dashed var(--rule); border-radius: 14px; padding: 36px; text-align: center; margin-top: 60px; }
    .more-soon-box h4 { font-family: 'Playfair Display', serif; font-size: 18px; color: var(--ink); margin-bottom: 8px; }
    .more-soon-box p { font-size: 13px; color: var(--faded); font-family: 'DM Mono', monospace; letter-spacing: .3px; }

    /* ════════════════════════════
       SITE FOOTER — identical to BSc page
    ════════════════════════════ */
    footer { background: #0b1f3a; color: rgba(255,255,255,.5); padding: 44px 24px 32px; }
    .footer-inner { max-width: 1180px; margin: auto; display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: 36px; padding-bottom: 32px; border-bottom: 1px solid rgba(255,255,255,.07); }
    .footer-col-title { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: rgba(255,255,255,.35); margin-bottom: 14px; }
    .footer-name { font-family: 'Lora', serif; font-size: 16px; font-weight: 600; color: rgba(255,255,255,.9); margin-bottom: 8px; }
    .footer-desc { font-size: 12.5px; line-height: 1.7; }
    .footer-nav-links, .footer-social-links { display: flex; flex-direction: column; gap: 7px; }
    .footer-nav-links a, .footer-social-links a { font-size: 13px; color: rgba(255,255,255,.55); transition: color .15s; }
    .footer-nav-links a:hover { color: rgba(255,255,255,.9); }
    .footer-social-links a:hover { color: #93c5fd; }
    .footer-bottom { max-width: 1180px; margin: 22px auto 0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; }
    .footer-bottom p { font-size: 12px; }
    @media (max-width: 1024px) { .footer-inner { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .footer-inner { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; text-align: center; } }

    @media (max-width: 600px) {
      .notebook-wrap { padding: 0 14px 60px; }
      .course-banner { padding: 24px 20px; }
      .toc-box { padding: 18px 18px; }
      .eq-name { min-width: 150px; font-size: 10.5px; }
      .eq-val { font-size: 11.5px; }
      .topic-num { font-size: 38px; min-width: 44px; }
    }
  </style>
